# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
build/
dist/
*.egg-info/

# Virtual environments
.venv/
venv/

# MLflow and experiment runs
mlruns/
mlflow.db
*.sqlite3

# Local artifacts, reports, and data
data/raw/*.csv
data/processed/*.parquet
data/processed/*.csv
data/reference/*.parquet
data/reference/*.csv
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/reference/.gitkeep
reports/*.png
reports/*.html
reports/*.json
!reports/.gitkeep

# Environment variables & local secrets
.env
.env.local

# IDE and OS
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# Testing and coverage
.pytest_cache/
.coverage
htmlcov/
.ruff_cache/

# DVC local storage
.dvc/cache/
.dvc/tmp/
.dvc_storage/
