# MLOps Platform Environment Configuration

# Application settings
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1

# MLflow Settings
# SQLite database tracking URI ensures local Model Registry works without external services
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
MLFLOW_EXPERIMENT_NAME=customer_churn_prediction
MODEL_REGISTRY_NAME=customer_churn_classifier

# Monitoring & Quality Gate Thresholds
MIN_ROC_AUC_THRESHOLD=0.70
MIN_F1_THRESHOLD=0.60
DRIFT_P_VALUE_THRESHOLD=0.05
MAX_LATENCY_MS_THRESHOLD=50.0

# Security & CORS
ALLOWED_ORIGINS=*
SECRET_KEY=change-this-in-production-placeholder-only
